# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para enlaces de login). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (waitlist)
RESEND_API_KEY=
# Segmento de contactos donde se añaden los inscritos (Resend → Audience → Segments)
RESEND_SEGMENT_ID=
# Remitente verificado en Resend, p. ej. "StableLens <hola@tudominio.com>"
RESEND_FROM_EMAIL=

# Orígenes que pueden llamar a /api/waitlist (landing estática), separados por coma
WAITLIST_ALLOWED_ORIGINS=https://stablelens.netlify.app

# Datos de mercado (S3)
# Secreto que protege /api/cron/sync-markets. Genera uno largo y aleatorio,
# p. ej. con: openssl rand -hex 32
CRON_SECRET=
# Opcional: clave "Demo" gratuita de CoinGecko (sin ella se usa la API pública, con menos cuota)
COINGECKO_API_KEY=

# Más adelante
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
STRIPE_SECRET_KEY=
